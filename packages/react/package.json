{
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "name": "archgraph-react",
  "description": "Composable 3D React architecture viewer for normalized graphs.",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "archgraph-core": "workspace:^",
    "@react-three/drei": "^10.7.7"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <19.3.0",
    "react-dom": ">=19.0.0 <19.3.0",
    "three": ">=0.170.0 <0.184.0",
    "@react-three/fiber": "^9.4.0"
  },
  "devDependencies": {
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "~0.182.0",
    "@react-three/fiber": "^9.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "~0.182.0",
    "vite": "^7.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordan-a-young/architecture-visualizer.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/jordan-a-young/architecture-visualizer#readme",
  "bugs": {
    "url": "https://github.com/jordan-a-young/architecture-visualizer/issues"
  }
}
